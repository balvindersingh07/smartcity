# Terraform (never commit secrets or state)
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfvars
!**/terraform.tfvars.example

# Local env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.Python
venv/
.venv/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/

# Frontend
node_modules/
**/dist/

# Logs / temp
*.log
/tmp/
